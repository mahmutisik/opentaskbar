    <Style x:Key="WidgetIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox>
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetGlyph" TargetType="ContentControl" BasedOn="{StaticResource WidgetIcon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox>
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WidgetCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WidgetRadius}" />
        <Setter Property="Height" Value="{StaticResource WidgetHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="{StaticResource WidgetSpacing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="WidgetText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WidgetCaption" TargetType="TextBlock" BasedOn="{StaticResource WidgetText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Round, borderless icon button used inside widget cards. -->
    <Style x:Key="WidgetIconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceKeyboardFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour-coded widget cards (WidgetTint): a soft diagonal tint and a matching rim, like the clock card. -->
    <LinearGradientBrush x:Key="WidgetTintTealFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#382DD4BF" Offset="0" />
        <GradientStop Color="#102DD4BF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintTealStroke" Color="#4A2DD4BF" />
    <LinearGradientBrush x:Key="WidgetTintSkyFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3838BDF8" Offset="0" />
        <GradientStop Color="#1038BDF8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintSkyStroke" Color="#4A38BDF8" />
    <LinearGradientBrush x:Key="WidgetTintCoralFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38F97316" Offset="0" />
        <GradientStop Color="#10F97316" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintCoralStroke" Color="#4AF97316" />
    <LinearGradientBrush x:Key="WidgetTintVioletFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38A78BFA" Offset="0" />
        <GradientStop Color="#10A78BFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintVioletStroke" Color="#4AA78BFA" />
    <LinearGradientBrush x:Key="WidgetTintAmberFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38F59E0B" Offset="0" />
        <GradientStop Color="#10F59E0B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintAmberStroke" Color="#4AF59E0B" />
    <LinearGradientBrush x:Key="WidgetTintSlateFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3894A3B8" Offset="0" />
        <GradientStop Color="#1094A3B8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintSlateStroke" Color="#4A94A3B8" />
    <LinearGradientBrush x:Key="WidgetTintRedFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38F87171" Offset="0" />
        <GradientStop Color="#10F87171" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintRedStroke" Color="#4AF87171" />
    <LinearGradientBrush x:Key="WidgetTintIndigoFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#386366F1" Offset="0" />
        <GradientStop Color="#106366F1" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetTintIndigoStroke" Color="#4A6366F1" />

    <!-- Drawn only when focus arrives from the keyboard, never after a mouse click. -->
    <Style x:Key="WidgetKeyboardFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{StaticResource WidgetRadius}" BorderThickness="1"
                            BorderBrush="{DynamicResource StrokeFocus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Whole-card button (clock, battery, meters) with a subtle hover. -->
    <Style x:Key="WidgetCardButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource WidgetCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WidgetCardStroke}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{StaticResource WidgetHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="{StaticResource WidgetSpacing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WidgetKeyboardFocusVisual}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource WidgetRadius}" />
                        <!-- Hover and press light the card from above, so a tinted card keeps its own colour. -->
                        <Border x:Name="StateLayer" CornerRadius="{StaticResource WidgetRadius}"
                                Background="{DynamicResource WidgetCardHover}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Background" Value="{DynamicResource SurfacePressed}" />
                            <Setter TargetName="StateLayer" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Capsule toggle for radios: checked draws the accent outline. -->
    <Style x:Key="WidgetPill" TargetType="ButtonBase">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource StrokeFocus}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceSelectedStrong}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WidgetOnStroke}" />
                            <Setter Property="Foreground" Value="{DynamicResource WidgetAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="2" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="12" Background="Transparent">
                        <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WidgetTrack}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WidgetAccentFill}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="10" Height="10">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource TextPrimary}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MediaProgressSlider" TargetType="Slider" BasedOn="{StaticResource WidgetSlider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="8" Background="Transparent">
                        <Border Height="3.5" CornerRadius="1.75" Background="{DynamicResource WidgetTrack}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3.5" CornerRadius="1.75" Background="{DynamicResource WidgetAccentFill}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="7" Height="7">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource TextPrimary}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rows and tiles inside dock flyouts (stacks, calendar, tray, desktops, launcher). -->
    <Style x:Key="FlyoutButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceKeyboardFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
