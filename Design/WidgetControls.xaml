        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:StopwatchDockWidget}">
        <widgets:TimedWidgetTile Title="{local:Loc WidgetStopwatch}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:CountdownDockWidget}">
        <widgets:TimedWidgetTile>
            <widgets:TimedWidgetTile.Style>
                <Style TargetType="widgets:TimedWidgetTile">
                    <Setter Property="Title" Value="{local:Loc WidgetCountdown}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:CountdownState.Finished}"><Setter Property="Title" Value="{local:Loc CountdownFinished}" /></DataTrigger>
                        <DataTrigger Binding="{Binding HasValidationError}" Value="True"><Setter Property="Title" Value="{local:Loc WidgetCorrectDuration}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </widgets:TimedWidgetTile.Style>
        </widgets:TimedWidgetTile>
    </DataTemplate>
</ResourceDictionary>
