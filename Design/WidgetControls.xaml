<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:models="clr-namespace:OpenTaskbar.Models"
                    xmlns:local="clr-namespace:OpenTaskbar.Services"
                    xmlns:widgets="clr-namespace:OpenTaskbar.Views.Widgets"
                    xmlns:w="clr-namespace:OpenTaskbar.Widgets">
    <sys:Double x:Key="TimedWidgetMinimumWidth">160</sys:Double>
    <sys:Double x:Key="TextSizeTimedWidgetValue">20</sys:Double>
    <sys:Double x:Key="WidgetQuickActionSize">36</sys:Double>
    <CornerRadius x:Key="WidgetQuickActionRadius">18</CornerRadius>
    <sys:Double x:Key="WidgetPanelWidth">320</sys:Double>
    <sys:Double x:Key="WidgetPanelGap">8</sys:Double>
    <sys:Double x:Key="WidgetPanelValueSize">32</sys:Double>
    <sys:Double x:Key="WidgetPanelActionHeight">36</sys:Double>
    <sys:Double x:Key="WidgetPanelHeadingSize">16</sys:Double>
    <sys:Double x:Key="WidgetActionGlyphSize">14</sys:Double>
    <Thickness x:Key="WidgetTileMargin">3,0</Thickness>
    <Thickness x:Key="WidgetPanelPadding">18</Thickness>
    <Thickness x:Key="WidgetPanelSectionMargin">0,16,0,0</Thickness>
    <Thickness x:Key="WidgetPanelFieldMargin">0,6,0,0</Thickness>
    <Thickness x:Key="WidgetPanelFieldPadding">10,6</Thickness>
    <FontFamily x:Key="WidgetActionFont">Segoe MDL2 Assets</FontFamily>
    <CornerRadius x:Key="WidgetFieldRadius">7</CornerRadius>
    <Style x:Key="WidgetTextField" TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource WidgetPanelFieldPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource WidgetPanelActionHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SettingsControl}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource WidgetFieldRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextSecondary}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource StrokeFocus}" /></Trigger>
                        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceSelected}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockWidgetFrame" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource DockWidgetMinimumWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource DockWidgetMinimumHeight}" />
        <Setter Property="Margin" Value="{StaticResource WidgetTileMargin}" />
        <Setter Property="Padding" Value="{StaticResource DockWidgetPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource DockWidgetRadius}" />
        <Setter Property="Background" Value="{DynamicResource DockWidgetSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="WidgetButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource DockWidgetActionPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource DockWidgetActionRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource StrokeFocus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WidgetQuickAction" TargetType="Button" BasedOn="{StaticResource WidgetButton}">
        <Setter Property="Width" Value="{StaticResource WidgetQuickActionSize}" />
        <Setter Property="Height" Value="{StaticResource WidgetQuickActionSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        <Setter Property="FontFamily" Value="{StaticResource WidgetActionFont}" />
        <Setter Property="FontSize" Value="{StaticResource WidgetActionGlyphSize}" />
        <Setter Property="Content" Value="&#xE768;" />
        <Setter Property="AutomationProperties.Name" Value="{local:Loc TimedWidgetStart}" />
        <Setter Property="ToolTip" Value="{local:Loc TimedWidgetStart}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource WidgetQuickActionRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource StrokeFocus}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Content" Value="&#xE769;" />
                <Setter Property="AutomationProperties.Name" Value="{local:Loc TimedWidgetPause}" />
                <Setter Property="ToolTip" Value="{local:Loc TimedWidgetPause}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanToggle}" Value="False">
                <Setter Property="Content" Value="&#xE713;" />
                <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="AutomationProperties.Name" Value="{local:Loc WidgetSetDuration}" />
                <Setter Property="ToolTip" Value="{local:Loc WidgetSetDuration}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="WidgetPanelAction" TargetType="Button" BasedOn="{StaticResource WidgetButton}">
        <Setter Property="Height" Value="{StaticResource WidgetPanelActionHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SettingsControl}" />
    </Style>
    <Style x:Key="WidgetPanelPrimaryAction" TargetType="Button" BasedOn="{StaticResource WidgetPanelAction}">
        <Setter Property="Content" Value="{local:Loc TimedWidgetStart}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Content" Value="{local:Loc TimedWidgetPause}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type models:DockWidgetItem}">
        <Grid AutomationProperties.Name="{Binding Label}">
            <!-- Default tile preview (modern WidgetCardBorder) -->
            <Border x:Name="DefaultTile" Style="{StaticResource WidgetCardBorder}" Padding="10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource WidgetCaption}" FontSize="9.5" FontWeight="Bold" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource WidgetText}" FontSize="13" Margin="0,1,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>

            <!-- Modern Battery Card -->
            <Border x:Name="BatteryCard" Padding="11,0" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource WidgetCardBorder}">
                        <Setter Property="Background" Value="{DynamicResource WidgetTintTealFill}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource WidgetTintTealStroke}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WidgetTintRedFill}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WidgetTintRedStroke}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconBattery}"
                                        Width="18" Height="18"
                                        Foreground="{DynamicResource WidgetAccent}" />
                        <!-- Charging bolt, centred in the battery body (the tip sits on the right). -->
                        <Path Data="{StaticResource IconZap}" Fill="{DynamicResource WidgetAccent}" Stretch="Fill"
                              Width="6" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5.7,4.5,0,0"
                              AutomationProperties.Name="{local:Loc Charging}" IsHitTestVisible="False">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource WidgetText}"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>

            <!-- Modern Storage Card -->
            <Border x:Name="StorageCard" Style="{StaticResource WidgetCardBorder}" Padding="11,0" Visibility="Collapsed">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconHardDrive}"
                                    Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center"
                                    Foreground="{DynamicResource WidgetAccent}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource WidgetText}" FontSize="12.5" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource WidgetTrack}" Margin="0,3,0,0">
                            <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Width="38" Background="{DynamicResource WidgetAccentFill}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Modern DayProgress Card -->
            <Border x:Name="DayProgressCard" Style="{StaticResource WidgetCardBorder}" Padding="11,0" Visibility="Collapsed">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconCalendar}"
                                    Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center"
                                    Foreground="{DynamicResource WidgetAccent}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource WidgetText}" FontSize="13.5" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource WidgetTrack}" Margin="0,3,0,0">
                            <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Width="38" Background="{DynamicResource WidgetAccentFill}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unified Date & Clock + Weather capsule preview -->
            <Border x:Name="ClockPreview" Style="{StaticResource WidgetCardBorder}" Padding="10,2,12,2" Visibility="Collapsed">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{local:Loc PreviewWeekday}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{local:Loc PreviewDate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,-1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Media widget taskbar preview (Album art + title/artist + progress bar + transport + volume) -->
            <Viewbox x:Name="MediaPreview" MaxWidth="188" StretchDirection="DownOnly" Visibility="Collapsed">
                <Border Style="{StaticResource WidgetCardBorder}" Width="296" Padding="6,0,8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="7" Background="{DynamicResource WidgetTrack}">
                            <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconMusic}" Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource WidgetText}" FontSize="11" />
                            <TextBlock Text="OpenTaskbar" Style="{StaticResource WidgetCaption}" FontSize="10" Margin="0,-1,0,0" />
                            <Slider Style="{StaticResource MediaProgressSlider}" Minimum="0" Maximum="100" Value="45" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPreviousFill}" Width="11" Height="11" Margin="5,0" Foreground="{DynamicResource TextPrimary}" />
                            <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPauseFill}" Width="14" Height="14" Margin="5,0" Foreground="{DynamicResource TextPrimary}" />
                            <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconNextFill}" Width="11" Height="11" Margin="5,0" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="1" Height="20" Fill="{DynamicResource StrokeSubtle}" Margin="4,0,6,0" />
                            <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconVolume}" Width="14" Height="14" Foreground="{DynamicResource TextPrimary}" />
                            <Slider Style="{StaticResource WidgetSlider}" Width="40" Value="80" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Viewbox>

            <!-- Audio widget taskbar preview -->
            <Border x:Name="AudioPreview" Style="{StaticResource WidgetCardBorder}" Width="178" Padding="6,0,12,0" Visibility="Collapsed">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Grid.RowSpan="2" VerticalAlignment="Center" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconVolume}" Width="16" Height="16" Margin="4,0" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource WidgetText}" Margin="4,0,6,0" FontSize="11.5" />
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource WidgetCaption}" />
                    <Slider Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource WidgetSlider}" Value="80" Margin="4,3,0,0" />
                </Grid>
            </Border>

            <!-- QuickSettings widget taskbar preview -->
            <Viewbox x:Name="QuickSettingsPreview" MaxWidth="188" StretchDirection="DownOnly" Visibility="Collapsed">
                <Border Style="{StaticResource WidgetCardBorder}" Padding="7,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="16" BorderThickness="1.5" Background="{DynamicResource SurfaceSelectedStrong}" BorderBrush="{DynamicResource WidgetOnStroke}" Margin="2,0" Padding="8,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconWifi}" Foreground="{DynamicResource WidgetAccent}" />
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource StrokeSubtle}" Margin="6,0" />
                                <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconChevronRight}" Width="11" Height="11" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="16" BorderThickness="1.5" Background="{DynamicResource SurfaceSelectedStrong}" BorderBrush="{DynamicResource WidgetOnStroke}" Margin="2,0" Padding="8,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconBluetooth}" Foreground="{DynamicResource WidgetAccent}" />
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource StrokeSubtle}" Margin="6,0" />
                                <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconChevronRight}" Width="11" Height="11" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource StrokeSubtle}" Margin="5,0" />
                        <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconSettings}" Margin="4,0" Foreground="{DynamicResource TextPrimary}" />
                        <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconBell}" Margin="4,0" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
            </Viewbox>

            <!-- SystemStats widget taskbar preview (CPU & RAM rings) -->
            <StackPanel x:Name="SystemStatsPreview" Orientation="Horizontal" Visibility="Collapsed">
                <Border Style="{StaticResource WidgetCardBorder}" Width="{StaticResource WidgetHeight}" Padding="3">
                    <w:RingMeter Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="CPU" Value="0.24" Text="24"
                                 CaptionBrush="{DynamicResource TextSecondary}" TrackBrush="{DynamicResource WidgetTrack}"
                                 ValueBrush="{DynamicResource WidgetAccent}" Foreground="{DynamicResource TextPrimary}" />
                </Border>
                <Border Style="{StaticResource WidgetCardBorder}" Width="{StaticResource WidgetHeight}" Padding="3">
                    <w:RingMeter Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="RAM" Value="0.58" Text="58"
                                 CaptionBrush="{DynamicResource TextSecondary}" TrackBrush="{DynamicResource WidgetTrack}"
                                 ValueBrush="{DynamicResource WidgetAccent}" Foreground="{DynamicResource TextPrimary}" />
                </Border>
            </StackPanel>

            <!-- AI usage widget taskbar preview (one card per provider: logo, name, usage ring) -->
            <StackPanel x:Name="AiUsagePreview" Orientation="Horizontal" Visibility="Collapsed">
                <Border Style="{StaticResource WidgetCardBorder}" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource LogoClaude}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="Claude" Width="44" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <w:RingMeter Width="34" Height="34" StrokeThickness="3" FontSize="10.5" Value="0.42" Text="42"
                                     TrackBrush="{DynamicResource TextMuted}" ValueBrush="{DynamicResource WidgetAccent}" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WidgetCardBorder}" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource LogoCodex}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="Codex" Width="44" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <w:RingMeter Width="34" Height="34" StrokeThickness="3" FontSize="10.5" Value="0.78" Text="78"
                                     TrackBrush="{DynamicResource TextMuted}" ValueBrush="{DynamicResource WidgetWarning}" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Focus (Pomodoro) widget taskbar preview -->
            <Border x:Name="FocusPreview" Style="{StaticResource WidgetCardBorder}" BorderThickness="1.5" Padding="12,0,8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" MinWidth="58">
                        <TextBlock Style="{StaticResource WidgetCaption}">
                            <Run Text="{local:Loc Focus}" FontWeight="SemiBold" Foreground="{DynamicResource WidgetFocusAccent}" />
                            <Run Text=" 1/4" />
                        </TextBlock>
                        <TextBlock Text="{Binding Value}" Style="{StaticResource WidgetText}" FontSize="19" Margin="0,-3,0,0" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconSkip}" Width="14" Height="14" Margin="8,0,6,0" Foreground="{DynamicResource TextPrimary}" />
                    <Grid Width="28" Height="28">
                        <Ellipse Width="28" Height="28" Fill="{DynamicResource WidgetFocusAccent}" />
                        <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPlayFill}" Width="13" Height="13" Foreground="#FFFFFFFF" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Weather widget taskbar preview -->
            <Border x:Name="WeatherPreview" Style="{StaticResource WidgetCardBorder}" Padding="10,0,12,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconSun}" Width="18" Height="18" Margin="0,0,6,0" Foreground="#F59E0B" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource WidgetText}" FontSize="15" />
                </StackPanel>
            </Border>

            <!-- Virtual Desktops widget taskbar preview -->
            <Border x:Name="DesktopsPreview" Style="{StaticResource WidgetCardBorder}" Padding="8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconChevronLeft}" Width="14" Height="14" Margin="3,0" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource WidgetText}" Margin="6,0" />
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconChevronNext}" Width="14" Height="14" Margin="3,0" Foreground="{DynamicResource TextPrimary}" />
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconPlus}" Width="14" Height="14" Margin="5,0,2,0" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
            </Border>

            <!-- System Tray (Background apps) widget taskbar preview -->
            <Border x:Name="TrayPreview" Style="{StaticResource WidgetCardBorder}" Padding="12,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource WidgetIcon}" Content="{StaticResource IconChevronUp}" Width="16" Height="16" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Id}" Value="Clock">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ClockPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Media">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MediaPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Audio">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AudioPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="QuickSettings">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="QuickSettingsPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="SystemStats">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SystemStatsPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="AiUsage">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AiUsagePreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Focus">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="FocusPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Weather">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="WeatherPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Desktops">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DesktopsPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Tray">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TrayPreview" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Battery">
                <Setter TargetName="DefaultTile" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="BatteryCard" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Storage">
